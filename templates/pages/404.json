{
  "sections": {
    "not_found_custom": {
      "type": "custom",
      "settings": {
        "direction": "column",
        "section_width": "full",
        "vertical_padding": 0,
        "horizontal_padding": 0,
        "gap": 0
      },
      "blocks": {
        "code_block": {
          "type": "code",
          "settings": {
            "code": "\n<script>\n(function() {\n  const path = window.location.pathname.toLowerCase();\n  \n  // Carrinho\n  if (path.includes('carrinho')) {\n    window.location.replace('/cart');\n    return;\n  }\n  \n  // Login & Conta\n  if (path.includes('login')) {\n    window.location.replace('/account/login');\n    return;\n  }\n  if (path.includes('cadastro') || path.includes('registrar') || path.includes('registro')) {\n    window.location.replace('/account/register');\n    return;\n  }\n  if (path.includes('conta') || path.includes('pedido')) {\n    window.location.replace('/account');\n    return;\n  }\n  \n  // Rastreio\n  if (path.includes('rastre')) {\n    window.location.replace('/account');\n    return;\n  }\n\n  // Categorias\n  if (path.includes('niche')) {\n    window.location.replace('/produtos?categoria=niche');\n  } else if (path.includes('arabe') || path.includes('árabe')) {\n    window.location.replace('/produtos?categoria=arabe');\n  } else if (path.includes('masculino')) {\n    window.location.replace('/produtos?categoria=masculinos');\n  } else if (path.includes('feminino')) {\n    window.location.replace('/produtos?categoria=femininos');\n  } else if (path.includes('compartilha')) {\n    window.location.replace('/produtos?categoria=compartilhaveis');\n  } else if (path.includes('oferta')) {\n    window.location.replace('/produtos?ofertas=true');\n  } else {\n    window.location.replace('/produtos');\n  }\n})();\n</script>\n<div style=\"padding: 100px 20px; text-align: center; font-family: 'Plus Jakarta Sans', sans-serif;\">\n  <p style=\"font-size: 18px; color: #1D3D40; font-weight: 700;\">Redirecionando com segurança...</p>\n</div>\n",
            "width": "fill"
          }
        }
      },
      "block_order": [
        "code_block"
      ]
    }
  },
  "order": [
    "not_found_custom"
  ]
}