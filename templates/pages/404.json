            "code": "\n<script>\n(function() {\n  const path = window.location.pathname.toLowerCase();\n  if (path.includes('niche')) {\n    window.location.replace('/produtos?categoria=niche');\n  } else if (path.includes('arabe') || path.includes('árabe')) {\n    window.location.replace('/produtos?categoria=arabe');\n  } else if (path.includes('masculino')) {\n    window.location.replace('/produtos?categoria=masculinos');\n  } else if (path.includes('feminino')) {\n    window.location.replace('/produtos?categoria=femininos');\n  } else if (path.includes('compartilha')) {\n    window.location.replace('/produtos?categoria=compartilhaveis');\n  } else if (path.includes('oferta')) {\n    window.location.replace('/produtos?ofertas=true');\n  } else {\n    window.location.replace('/produtos');\n  }\n})();\n</script>\n<div style=\"padding: 100px 20px; text-align: center;\">\n  <p style=\"font-size: 18px; color: #1D3D40;\">Redirecionando para a coleção de perfumes Glitz...</p>\n</div>\n",
            "width": "fill"
          }
        }
      },
