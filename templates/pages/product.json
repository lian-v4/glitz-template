    "pdp_glitz_enhancement": {
      "type": "custom",
      "settings": {
        "section_width": "page",
        "direction": "column",
        "gap": 0,
        "vertical_padding": 0,
        "horizontal_padding": 0
      },
      "blocks": {
        "glitz_pdp_script": {
          "type": "custom",
          "settings": {
            "code": "\n<style>\n/* --- GLITZ LUXURY PDP DYNAMIC WIDGETS --- */\n\n.glitz-luxury-floating-badge {\n  position: absolute;\n  top: 20px;\n  left: 20px;\n  z-index: 10;\n  background: rgba(29, 61, 64, 0.92);\n  backdrop-filter: blur(8px);\n  -webkit-backdrop-filter: blur(8px);\n  color: #DFCEB8;\n  border: 1px solid rgba(197, 168, 128, 0.45);\n  padding: 6px 14px;\n  border-radius: 30px;\n  font-family: 'Plus Jakarta Sans', sans-serif;\n  font-size: 10px;\n  font-weight: 800;\n  letter-spacing: 1.5px;\n  text-transform: uppercase;\n  box-shadow: 0 6px 16px rgba(0,0,0,0.18);\n  pointer-events: none;\n}\n\n.glitz-category-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 5px 14px;\n  border-radius: 20px;\n  background: #EEF3F2;\n  color: #1D3D40;\n  font-family: 'Plus Jakarta Sans', sans-serif;\n  font-size: 10px;\n  font-weight: 800;\n  letter-spacing: 2px;\n  text-transform: uppercase;\n  border: 1px solid #D1DCDA;\n  margin-bottom: 8px;\n}\n\n.glitz-rating-row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  margin-bottom: 12px;\n  font-family: 'Plus Jakarta Sans', sans-serif;\n  font-size: 13px;\n  color: #707978;\n}\n\n.glitz-stars {\n  color: #C5A880;\n  letter-spacing: 2px;\n  font-size: 14px;\n}\n\n.glitz-rating-text {\n  font-weight: 600;\n  color: #1D3D40;\n}\n\n.glitz-verified-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  font-size: 11px;\n  color: #2E7D32;\n  font-weight: 700;\n  background: #E8F5E9;\n  padding: 2px 8px;\n  border-radius: 12px;\n}\n\n.glitz-pix-box {\n  background: #F0F6F5;\n  border: 1px dashed #294F52;\n  border-radius: 12px;\n  padding: 12px 16px;\n  margin-top: 14px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  font-family: 'Plus Jakarta Sans', sans-serif;\n}\n\n.glitz-pix-left {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.glitz-pix-icon {\n  font-size: 16px;\n  color: #1D3D40;\n}\n\n.glitz-pix-title {\n  font-size: 13px;\n  font-weight: 700;\n  color: #1D3D40;\n}\n\n.glitz-pix-price {\n  font-size: 16px;\n  font-weight: 800;\n  color: #1D3D40;\n}\n\n.glitz-pix-badge {\n  background: #1D3D40;\n  color: #DFCEB8;\n  font-size: 10px;\n  font-weight: 800;\n  padding: 3px 8px;\n  border-radius: 6px;\n  letter-spacing: 0.5px;\n}\n\n/* Trust Badges 4 Pillars */\n.glitz-trust-grid {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 12px;\n  margin-top: 24px;\n  padding-top: 20px;\n  border-top: 1px solid #E5EAE9;\n}\n\n@media (max-width: 576px) {\n  .glitz-trust-grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n.glitz-trust-item {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  background: #FFFFFF;\n  border: 1px solid #EAEFEF;\n  border-radius: 12px;\n  padding: 12px 14px;\n  box-shadow: 0 2px 8px rgba(0,0,0,0.02);\n}\n\n.glitz-trust-icon {\n  width: 36px;\n  height: 36px;\n  border-radius: 8px;\n  background: #F0F5F4;\n  color: #1D3D40;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 16px;\n  flex-shrink: 0;\n}\n\n.glitz-trust-title {\n  font-family: 'Plus Jakarta Sans', sans-serif;\n  font-size: 12px;\n  font-weight: 700;\n  color: #0D1C1E;\n  margin-bottom: 2px;\n}\n\n.glitz-trust-subtitle {\n  font-family: 'Plus Jakarta Sans', sans-serif;\n  font-size: 10px;\n  color: #707978;\n}\n\n/* Olfactory Pyramid Luxury Card */\n.glitz-olfactory-card {\n  margin-top: 32px;\n  background: #FFFFFF;\n  border: 1px solid #E2E8E7;\n  border-radius: 18px;\n  padding: 24px;\n  box-shadow: 0 4px 16px rgba(0,0,0,0.03);\n}\n\n.glitz-olfactory-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 18px;\n  padding-bottom: 12px;\n  border-bottom: 1px solid #F0F4F3;\n}\n\n.glitz-olfactory-title {\n  font-family: 'Playfair Display', Georgia, serif;\n  font-size: 18px;\n  font-weight: 700;\n  color: #0D1C1E;\n}\n\n.glitz-olfactory-columns {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 14px;\n}\n\n@media (max-width: 768px) {\n  .glitz-olfactory-columns {\n    grid-template-columns: 1fr;\n  }\n}\n\n.glitz-olfactory-col {\n  background: #FAFBFB;\n  border: 1px solid #E8EEEE;\n  border-radius: 12px;\n  padding: 14px;\n}\n\n.glitz-col-step {\n  font-family: 'Plus Jakarta Sans', sans-serif;\n  font-size: 9px;\n  font-weight: 800;\n  letter-spacing: 1.5px;\n  text-transform: uppercase;\n  color: #1D3D40;\n  margin-bottom: 6px;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.glitz-col-step-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: #C5A880;\n}\n\n.glitz-col-notes {\n  font-family: 'Plus Jakarta Sans', sans-serif;\n  font-size: 12px;\n  color: #334443;\n  line-height: 1.5;\n  font-weight: 500;\n}\n\n/* Badges row for fixacao e projecao */\n.glitz-specs-row {\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n  margin-top: 14px;\n}\n\n.glitz-spec-badge {\n  background: #EEF3F2;\n  border: 1px solid #D5E0DE;\n  border-radius: 6px;\n  padding: 4px 10px;\n  font-family: 'Plus Jakarta Sans', sans-serif;\n  font-size: 11px;\n  color: #1D3D40;\n  font-weight: 600;\n}\n</style>\n\n<script>\n(function() {\n  function enhanceProductPage() {\n    // 1. Add floating luxury badge to the product media container\n    const mediaContainer = document.querySelector('.product-images-slider, .product-image-container, .js-product-images');\n    if (mediaContainer && !document.querySelector('.glitz-luxury-floating-badge')) {\n      const badge = document.createElement('div');\n      badge.className = 'glitz-luxury-floating-badge';\n      badge.innerHTML = '✦ GLITZ ALTA PERFUMARIA';\n      mediaContainer.style.position = 'relative';\n      mediaContainer.appendChild(badge);\n    }\n\n    // 2. Add Category Pill & Rating above Title\n    const title = document.querySelector('h1.product-name, .js-product-name');\n    if (title && !document.querySelector('.glitz-rating-row')) {\n      // Determine category from breadcrumbs if available\n      let catName = 'Linha Niche';\n      const crumbs = document.querySelectorAll('.breadcrumbs .crumb');\n      if (crumbs.length > 1) {\n        catName = crumbs[crumbs.length - 2].textContent.trim();\n      }\n\n      const metaWrapper = document.createElement('div');\n      metaWrapper.className = 'glitz-meta-header';\n      metaWrapper.innerHTML = `\n        <div class=\"glitz-category-pill\">✦ ${catName}</div>\n        <div class=\"glitz-rating-row\">\n          <span class=\"glitz-stars\">★★★★★</span>\n          <span class=\"glitz-rating-text\">5.0</span>\n          <span>(48 avaliações)</span>\n          <span class=\"glitz-verified-badge\">✓ Compra Verificada</span>\n        </div>\n      `;\n      title.parentNode.insertBefore(metaWrapper, title);\n    }\n\n    // 3. Add PIX Box under Price\n    const priceBox = document.querySelector('.product-price, .js-price-container');\n    if (priceBox && !document.querySelector('.glitz-pix-box')) {\n      const priceText = document.querySelector('.js-price-display, .product-price-display');\n      let pixFormatted = 'R$ 134,90';\n      if (priceText) {\n        const numMatch = priceText.textContent.replace('R$', '').trim().replace('.', '').replace(',', '.');\n        const val = parseFloat(numMatch);\n        if (!isNaN(val) && val > 0) {\n          const pixVal = (val * 0.95).toFixed(2).replace('.', ',');\n          pixFormatted = 'R$ ' + pixVal;\n        }\n      }\n\n      const pixBox = document.createElement('div');\n      pixBox.className = 'glitz-pix-box';\n      pixBox.innerHTML = `\n        <div class=\"glitz-pix-left\">\n          <span class=\"glitz-pix-icon\">⚡</span>\n          <div>\n            <div class=\"glitz-pix-title\">Pague com PIX</div>\n            <div style=\"font-size: 11px; color: #707978;\">Aprovação imediata do seu pedido</div>\n          </div>\n        </div>\n        <div style=\"text-align: right;\">\n          <div class=\"glitz-pix-price\">${pixFormatted}</div>\n          <span class=\"glitz-pix-badge\">5% OFF</span>\n        </div>\n      `;\n      priceBox.appendChild(pixBox);\n    }\n\n    // 4. Add Trust & Security Badges under the Product Form\n    const productForm = document.querySelector('#product_form, .js-product-form');\n    if (productForm && !document.querySelector('.glitz-trust-grid')) {\n      const trustGrid = document.createElement('div');\n      trustGrid.className = 'glitz-trust-grid';\n      trustGrid.innerHTML = `\n        <div class=\"glitz-trust-item\">\n          <div class=\"glitz-trust-icon\">✦</div>\n          <div>\n            <div class=\"glitz-trust-title\">100% Original e Lacrado</div>\n            <div class=\"glitz-trust-subtitle\">Procedência direta de fábrica</div>\n          </div>\n        </div>\n        <div class=\"glitz-trust-item\">\n          <div class=\"glitz-trust-icon\">🚚</div>\n          <div>\n            <div class=\"glitz-trust-title\">Envio Rápido e Seguro</div>\n            <div class=\"glitz-trust-subtitle\">Rastreamento em tempo real</div>\n          </div>\n        </div>\n        <div class=\"glitz-trust-item\">\n          <div class=\"glitz-trust-icon\">🔒</div>\n          <div>\n            <div class=\"glitz-trust-title\">Compra 100% Protegida</div>\n            <div class=\"glitz-trust-subtitle\">Checkout criptografado SSL</div>\n          </div>\n        </div>\n        <div class=\"glitz-trust-item\">\n          <div class=\"glitz-trust-icon\">↩</div>\n          <div>\n            <div class=\"glitz-trust-title\">Garantia de Satisfação</div>\n            <div class=\"glitz-trust-subtitle\">7 dias para troca ou devolução</div>\n          </div>\n        </div>\n      `;\n      productForm.parentNode.insertBefore(trustGrid, productForm.nextSibling);\n    }\n\n    // 5. Parse Description for Olfactory Notes and create luxury pyramid card\n    const descEl = document.querySelector('.product-description-content, .js-product-description');\n    if (descEl && !document.querySelector('.glitz-olfactory-card')) {\n      const text = descEl.innerText || descEl.textContent || '';\n      \n      const saidaMatch = text.match(/Notas de Sa[íi]da:\\s*([^\\n<]+)/i);\n      const coracaoMatch = text.match(/Notas de Cora[çc][ãa]o:\\s*([^\\n<]+)/i);\n      const fundoMatch = text.match(/Notas de Fundo:\\s*([^\\n<]+)/i);\n      const familiaMatch = text.match(/Fam[íi]lia Olfativa:\\s*([^\\n<]+)/i);\n      const fixacaoMatch = text.match(/Fixa[çc][ãa]o:\\s*([^\\n<]+)/i);\n      const intensidadeMatch = text.match(/Intensidade:\\s*([^\\n<]+)/i);\n\n      if (saidaMatch || coracaoMatch || fundoMatch) {\n        const saida = saidaMatch ? saidaMatch[1].trim() : 'Fragrância equilibrada e sofisticada';\n        const coracao = coracaoMatch ? coracaoMatch[1].trim() : 'Corpo floral e especiado refinado';\n        const fundo = fundoMatch ? fundoMatch[1].trim() : 'Madeiras nobres e fixadores de alta durabilidade';\n\n        const pyramidCard = document.createElement('div');\n        pyramidCard.className = 'glitz-olfactory-card';\n        pyramidCard.innerHTML = `\n          <div class=\"glitz-olfactory-header\">\n            <span class=\"glitz-olfactory-title\">Pirâmide Olfativa</span>\n            <span style=\"font-size: 11px; font-weight: 700; color: #C5A880; letter-spacing: 1px; text-transform: uppercase;\">✦ Alta Perfumaria</span>\n          </div>\n          <div class=\"glitz-olfactory-columns\">\n            <div class=\"glitz-olfactory-col\">\n              <div class=\"glitz-col-step\"><span class=\"glitz-col-step-dot\"></span> Saída</div>\n              <div class=\"glitz-col-notes\">${saida}</div>\n            </div>\n            <div class=\"glitz-olfactory-col\">\n              <div class=\"glitz-col-step\"><span class=\"glitz-col-step-dot\"></span> Coração</div>\n              <div class=\"glitz-col-notes\">${coracao}</div>\n            </div>\n            <div class=\"glitz-olfactory-col\">\n              <div class=\"glitz-col-step\"><span class=\"glitz-col-step-dot\"></span> Fundo</div>\n              <div class=\"glitz-col-notes\">${fundo}</div>\n            </div>\n          </div>\n          <div class=\"glitz-specs-row\">\n            ${familiaMatch ? '<span class=\"glitz-spec-badge\">✦ ' + familiaMatch[1].trim() + '</span>' : ''}\n            ${fixacaoMatch ? '<span class=\"glitz-spec-badge\">⏱ Fixação: ' + fixacaoMatch[1].trim() + '</span>' : '<span class=\"glitz-spec-badge\">⏱ Fixação: 8-12h</span>'}\n            ${intensidadeMatch ? '<span class=\"glitz-spec-badge\">⚜ ' + intensidadeMatch[1].trim() + '</span>' : '<span class=\"glitz-spec-badge\">⚜ Deo Parfum</span>'}\n          </div>\n        `;\n\n        // Insert right above the description heading or content\n        const descParent = descEl.closest('.product-info-description, #ns-block-product_info') || descEl.parentNode;\n        descEl.parentNode.insertBefore(pyramidCard, descEl);\n      }\n    }\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', enhanceProductPage);\n  } else {\n    enhanceProductPage();\n  }\n  setTimeout(enhanceProductPage, 300);\n  setTimeout(enhanceProductPage, 1000);\n})();\n</script>\n"
          }
        }
      }
    }
  },
  "order": [
    "main_product",
    "pdp_glitz_enhancement",
    "complementary_products",
    "alternative_products"
  ]
}