{
  "sections": {
    "main_product": {
      "type": "main-product",
      "settings": {
        "section_width": "page"
      },
      "blocks": {
        "product_media": {
          "type": "product-media",
          "settings": {
            "show_thumbnails": true,
            "thumbnail_position": "bottom",
            "format": "slider",
            "columns": "1_and_2",
            "gap": 12
          }
        },
        "product_info": {
          "type": "product-info",
          "settings": {
            "gap": 40,
            "vertical_padding": 8,
            "horizontal_padding": 0
          },
          "blocks": {
            "description": {
              "type": "description",
              "settings": {
                "show_title": true,
                "show_social": true
              }
            },
            "purchase_info": {
              "type": "purchase-info",
              "settings": {
                "icon_size": 24,
                "title_size": "paragraph",
                "description_size": "paragraph_small",
                "gap": 24
              },
              "blocks": {
                "icon_returns": {
                  "type": "icon-text-item",
                  "settings": {
                    "icon": "returns",
                    "title": "Seu título aqui",
                    "description": "Seu texto aqui"
                  }
                },
                "icon_security": {
                  "type": "icon-text-item",
                  "settings": {
                    "icon": "security",
                    "title": "Seu título aqui",
                    "description": "Seu texto aqui"
                  }
                }
              },
              "block_order": [
                "icon_returns",
                "icon_security"
              ]
            }
          },
          "block_order": [
            "description",
            "purchase_info"
          ]
        }
      },
      "block_order": [
        "product_media",
        "product_info"
      ]
    },
    "complementary_products": {
      "type": "related-products",
      "settings": {
        "products_source": "complementary",
        "section_width": "page",
        "gap": 32,
        "vertical_padding": 0,
        "horizontal_padding": 0
      },
      "blocks": {
