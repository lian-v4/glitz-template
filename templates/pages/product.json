{
  "sections": {
    "main_product": {
      "type": "main-product",
      "settings": {
        "section_width": "page"
      },
      "blocks": {
        "product_media": {
          "type": "product-media",
          "settings": {
            "show_thumbnails": true,
            "thumbnail_position": "bottom",
            "format": "slider",
            "columns": "1_and_2",
            "gap": 12
          }
        },
        "product_info": {
          "type": "product-info",
          "settings": {
            "gap": 40,
            "vertical_padding": 8,
            "horizontal_padding": 0
          },
          "blocks": {
            "description": {
              "type": "description",
              "settings": {
                "show_title": true,
                "show_social": true
              }
            },
            "purchase_info": {
              "type": "purchase-info",
              "settings": {
                "icon_size": 28,
                "title_size": "paragraph",
                "description_size": "paragraph_small",
                "gap": 16
              },
              "blocks": {
                "icon_security": {
                  "type": "icon-text-item",
                  "settings": {
                    "icon": "security",
                    "title": "Compra 100% Segura",
                    "description": "Ambiente protegido com criptografia SSL e total privacidade."
                  }
                },
                "icon_origin": {
                  "type": "icon-text-item",
                  "settings": {
                    "icon": "check",
                    "title": "100% Original e Lacrado",
                    "description": "Fragrâncias exclusivas com garantia de procedência oficial."
                  }
                },
                "icon_shipping": {
                  "type": "icon-text-item",
                  "settings": {
                    "icon": "shipping",
                    "title": "Envio Rápido com Rastreio",
                    "description": "Entrega segura para todo o Brasil com código de rastreamento."
                  }
                },
                "icon_returns": {
                  "type": "icon-text-item",
                  "settings": {
                    "icon": "returns",
                    "title": "Garantia de Satisfação",
                    "description": "Até 7 dias para troca ou devolução sem burocracia."
                  }
                }
              },
              "block_order": [
                "icon_security",
                "icon_origin",
                "icon_shipping",
                "icon_returns"
              ]
            }
          },
          "block_order": [
            "description",
            "purchase_info"
          ]
        }
      },
      "block_order": [
        "product_media",
        "product_info"
      ]
    },
    "complementary_products": {
      "type": "related-products",
      "settings": {
        "products_source": "complementary",
        "section_width": "page",
        "gap": 32,
        "vertical_padding": 0,
        "horizontal_padding": 0
      },
      "blocks": {
        "complementary_heading": {
          "type": "heading",
          "settings": {
            "title": "Fragrâncias Complementares",
            "size": "h2"
          }
        },
        "complementary_products_block": {
          "type": "product-recommendations",
          "settings": {
            "columns": "4",
            "columns_mobile": "2"
          }
        }
      },
      "block_order": [
        "complementary_heading",
        "complementary_products_block"
      ]
    },
    "alternative_products": {
      "type": "related-products",
      "settings": {
        "products_source": "alternative",
        "section_width": "page",
        "gap": 32,
        "vertical_padding": 0,
        "horizontal_padding": 0
      },
      "blocks": {
        "alternative_heading": {
          "type": "heading",
          "settings": {
            "title": "Você Também Pode Gostar",
            "size": "h2"
          }
        },
        "alternative_products_block": {
          "type": "product-recommendations",
          "settings": {
            "columns": "4",
            "columns_mobile": "2"
          }
        }
      },
      "block_order": [
        "alternative_heading",
        "alternative_products_block"
      ]
    }
  },
  "order": [
    "main_product",
    "complementary_products",
    "alternative_products"
  ]
}