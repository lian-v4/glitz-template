      "blocks": {
        "catalog_block": {
          "type": "code",
          "settings": {
            "code": "\n<style>\n/* Hide Nuvemshop native empty placeholders on category / produtos pages */\n.section-main-products-grid,\n.section-category-hero,\n.section-page-header {\n  display: none !important;\n}\n\n.glitz-catalog-wrapper {\n  background: #FFFFFF;\n  padding: 30px 0 100px 0;\n  width: 100%;\n}\n\n.glitz-catalog-container {\n  max-width: 1400px;\n  margin: 0 auto;\n  padding: 0 24px;\n}\n\n/* Header Banner */\n.glitz-catalog-header {\n  text-align: center;\n  margin-bottom: 40px;\n  padding: 45px 20px;\n  background: radial-gradient(circle at 50% 50%, #1A363A 0%, #0D1C1E 100%);\n  border-radius: 24px;\n  color: #FFFFFF;\n  position: relative;\n  overflow: hidden;\n  box-shadow: 0 15px 35px rgba(13,28,30,0.15);\n}\n\n.glitz-catalog-header-glow {\n  position: absolute;\n  top: -80px;\n  right: -80px;\n  width: 260px;\n  height: 260px;\n  background: rgba(197, 168, 128, 0.2);\n  border-radius: 50%;\n  filter: blur(80px);\n  pointer-events: none;\n}\n\n.glitz-catalog-eyebrow {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n  color: #DFCEB8;\n  margin-bottom: 12px;\n}\n\n.glitz-catalog-title {\n  font-size: clamp(2.4rem, 4vw, 3.8rem);\n  font-weight: 300;\n  color: #FFFFFF;\n  margin: 0 0 12px 0;\n  line-height: 1.1;\n}\n\n.glitz-catalog-title strong {\n  font-weight: 700;\n  background: linear-gradient(135deg, #DFCEB8 0%, #C5A880 50%, #EAE3D2 100%);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n}\n\n.glitz-catalog-desc {\n  font-size: 15px;\n  color: rgba(255, 255, 255, 0.75);\n  max-width: 620px;\n  margin: 0 auto;\n  line-height: 1.6;\n  font-weight: 300;\n}\n\n/* Filter Pills Bar */\n.glitz-filters-bar {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 12px;\n  flex-wrap: wrap;\n  margin-bottom: 40px;\n  padding: 0 10px;\n}\n\n.glitz-filter-btn {\n  background: #F8F7F3;\n  border: 1px solid #E5EAE9;\n  color: #1D3D40;\n  font-family: 'Plus Jakarta Sans', sans-serif;\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  padding: 12px 22px;\n  border-radius: 9999px;\n  cursor: pointer;\n  transition: all 0.25s ease;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  text-decoration: none !important;\n}\n\n.glitz-filter-btn:hover {\n  background: #EAE6DF;\n  transform: translateY(-1px);\n}\n\n.glitz-filter-btn.active {\n  background: #1D3D40;\n  color: #FFFFFF;\n  border-color: #1D3D40;\n  box-shadow: 0 4px 15px rgba(29, 61, 64, 0.25);\n}\n\n.glitz-filter-btn.offer-btn {\n  color: #C84B31;\n  border-color: rgba(200, 75, 49, 0.3);\n}\n\n.glitz-filter-btn.offer-btn.active {\n  background: #C84B31;\n  color: #FFFFFF;\n  border-color: #C84B31;\n}\n\n.glitz-catalog-count {\n  font-size: 13px;\n  color: #66706F;\n  margin-bottom: 24px;\n  font-weight: 500;\n  text-align: center;\n}\n\n/* Products Grid */\n.glitz-catalog-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 24px;\n}\n\n@media (max-width: 1100px) {\n  .glitz-catalog-grid { grid-template-columns: repeat(3, 1fr); gap: 18px; }\n}\n\n@media (max-width: 768px) {\n  .glitz-catalog-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }\n  .glitz-filter-btn { padding: 10px 16px; font-size: 11px; }\n}\n\n.glitz-cat-card-item {\n  background: #FFFFFF;\n  border-radius: 16px;\n  border: 1px solid #E5EAE9;\n  overflow: hidden;\n  transition: all 0.35s ease;\n  display: flex;\n  flex-direction: column;\n}\n\n.glitz-cat-card-item:hover {\n  transform: translateY(-6px);\n  border-color: #DFCEB8;\n  box-shadow: 0 16px 32px rgba(0,0,0,0.08);\n}\n\n.glitz-cat-card-media {\n  position: relative;\n  aspect-ratio: 1 / 1;\n  background: #F8F9FA;\n  overflow: hidden;\n}\n\n.glitz-cat-card-img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: transform 0.6s ease;\n}\n\n.glitz-cat-card-item:hover .glitz-cat-card-img {\n  transform: scale(1.06);\n}\n\n.glitz-cat-card-badge {\n  position: absolute;\n  top: 12px;\n  left: 12px;\n  background: #1D3D40;\n  color: #FFFFFF;\n  font-size: 9px;\n  font-weight: 800;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  padding: 4px 10px;\n  border-radius: 4px;\n  z-index: 10;\n}\n\n.glitz-badge-red { background: #C84B31 !important; }\n\n.glitz-cat-card-details {\n  padding: 18px;\n  display: flex;\n  flex-direction: column;\n  flex-grow: 1;\n}\n\n.glitz-cat-card-meta {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 6px;\n}\n\n.glitz-cat-card-category {\n  font-size: 10px;\n  color: #66706F;\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n  font-weight: 700;\n}\n\n.glitz-cat-card-rating {\n  font-size: 11px;\n  color: #C5A880;\n  font-weight: 700;\n}\n\n.glitz-cat-card-name {\n  font-size: 1.1rem;\n  font-weight: 600;\n  line-height: 1.3;\n  margin: 0 0 4px 0;\n  color: #182324;\n}\n\n.glitz-cat-card-family {\n  font-size: 11px;\n  color: #66706F;\n  margin: 0 0 14px 0;\n  font-weight: 400;\n}\n\n.glitz-cat-card-price-row {\n  display: flex;\n  align-items: baseline;\n  gap: 8px;\n  margin-top: auto;\n}\n\n.glitz-cat-card-price {\n  font-size: 1.25rem;\n  font-weight: 800;\n  color: #1D3D40;\n}\n\n.glitz-cat-card-old-price {\n  font-size: 0.9rem;\n  color: #A0A5A5;\n  text-decoration: line-through;\n}\n\n.glitz-cat-card-installments {\n  font-size: 11px;\n  color: #66706F;\n  margin-top: 4px;\n}\n\n.glitz-cat-card-btn {\n  margin-top: 14px;\n  background: #C5A880;\n  color: #FFFFFF !important;\n  text-decoration: none !important;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  padding: 10px 16px;\n  border-radius: 9999px;\n  text-align: center;\n  transition: all 0.2s ease;\n  border: none;\n  cursor: pointer;\n}\n\n.glitz-cat-card-btn:hover {\n  background: #9D7F57;\n  filter: brightness(1.05);\n}\n</style>\n\n<div class=\"glitz-catalog-wrapper\">\n  <div class=\"glitz-catalog-container\">\n    \n    <!-- Dynamic Header -->\n    <div class=\"glitz-catalog-header\">\n      <div class=\"glitz-catalog-header-glow\"></div>\n      <div class=\"glitz-catalog-eyebrow\">\n        <span>✦</span> ALTA PERFUMARIA GLITZ <span>✦</span>\n      </div>\n      <h1 class=\"glitz-catalog-title\" id=\"glitz-catalog-title\">\n        Todos os <strong>Perfumes</strong>\n      </h1>\n      <p class=\"glitz-catalog-desc\" id=\"glitz-catalog-desc\">\n        Explore nossa curadoria de fragrâncias de alta concentração, matérias-primas nobres e projeção marcante.\n      </p>\n    </div>\n\n    <!-- Filter Buttons -->\n    <div class=\"glitz-filters-bar\">\n      <button type=\"button\" class=\"glitz-filter-btn active\" data-filter=\"all\">Todos (48)</button>\n      <button type=\"button\" class=\"glitz-filter-btn\" data-filter=\"niche\">👑 Linha Niche (6)</button>\n      <button type=\"button\" class=\"glitz-filter-btn\" data-filter=\"arabe\">🌙 Linha Árabe (7)</button>\n      <button type=\"button\" class=\"glitz-filter-btn\" data-filter=\"masculinos\">👔 Masculinos (18)</button>\n      <button type=\"button\" class=\"glitz-filter-btn\" data-filter=\"femininos\">💄 Femininos (12)</button>\n      <button type=\"button\" class=\"glitz-filter-btn\" data-filter=\"compartilhaveis\">💎 Compartilháveis (5)</button>\n      <button type=\"button\" class=\"glitz-filter-btn offer-btn\" data-filter=\"ofertas\">🔥 Ofertas Especiais</button>\n    </div>\n\n    <div class=\"glitz-catalog-count\" id=\"glitz-catalog-count\">\n      Exibindo <strong>48</strong> fragrâncias exclusivas\n    </div>\n\n    <!-- Grid of Products -->\n    <div class=\"glitz-catalog-grid\" id=\"glitz-catalog-grid\"></div>\n\n  </div>\n</div>\n\n\n<script>\n(function() {\n  function injectGlitzHeaderLinks() {\n    const navUl = document.querySelector('.js-nav-desktop-list');\n    if (navUl) {\n      const navItems = [\n        { name: 'TODOS OS PERFUMES', url: '/produtos', key: 'all' },\n        { name: 'LINHA NICHE', url: '/produtos?categoria=niche', key: 'niche' },\n        { name: 'LINHA ÁRABE', url: '/produtos?categoria=arabe', key: 'arabe' },\n        { name: 'MASCULINOS', url: '/produtos?categoria=masculinos', key: 'masculinos' },\n        { name: 'FEMININOS', url: '/produtos?categoria=femininos', key: 'femininos' },\n        { name: 'COMPARTILHÁVEIS', url: '/produtos?categoria=compartilhaveis', key: 'compartilhaveis' },\n        { name: 'OFERTAS', url: '/produtos?ofertas=true', key: 'ofertas', accent: true }\n      ];\n\n      const currentParams = new URLSearchParams(window.location.search);\n      const activeCat = currentParams.get('categoria') || (currentParams.get('ofertas') === 'true' ? 'ofertas' : '');\n\n      navUl.innerHTML = navItems.map(item => {\n        const isActive = item.key === activeCat || (item.key === 'all' && !activeCat && window.location.pathname.includes('/produtos'));\n        const color = item.accent ? '#C84B31' : (isActive ? '#C5A880' : '#1D3D40');\n        const borderBottom = isActive ? 'border-bottom: 2px solid #C5A880;' : '';\n\n        return `\n          <li class=\"nav-item nav-main-item\" style=\"margin: 0 10px;\">\n            <a href=\"${item.url}\" class=\"nav-list-link\" style=\"\n              font-family: 'Plus Jakarta Sans', sans-serif !important;\n              font-size: 11px !important;\n              font-weight: 700 !important;\n              letter-spacing: 0.14em !important;\n              text-transform: uppercase !important;\n              color: ${color} !important;\n              text-decoration: none !important;\n              padding-bottom: 4px;\n              ${borderBottom}\n              transition: all 0.2s ease;\n            \" onmouseover=\"this.style.color='#C5A880'\" onmouseout=\"this.style.color='${color}'\">\n              ${item.name}\n            </a>\n          </li>\n        `;\n      }).join('');\n\n      const navContainer = document.querySelector('.js-nav-desktop-container');\n      if (navContainer) {\n        navContainer.style.visibility = 'visible';\n        navContainer.style.height = 'auto';\n        navContainer.style.display = 'block';\n      }\n    }\n\n    const mobileUl = document.querySelector('.nav-categories-mobile') || document.querySelector('.js-mobile-nav-list');\n    if (mobileUl && !mobileUl.getAttribute('data-glitz-nav-done')) {\n      mobileUl.setAttribute('data-glitz-nav-done', 'true');\n      const mobileItems = [\n        { name: 'Todos os Perfumes', url: '/produtos' },\n        { name: 'Linha Niche', url: '/produtos?categoria=niche' },\n        { name: 'Linha Árabe', url: '/produtos?categoria=arabe' },\n        { name: 'Perfumes Masculinos', url: '/produtos?categoria=masculinos' },\n        { name: 'Perfumes Femininos', url: '/produtos?categoria=femininos' },\n        { name: 'Compartilháveis', url: '/produtos?categoria=compartilhaveis' },\n        { name: 'Ofertas da Semana', url: '/produtos?ofertas=true', accent: true }\n      ];\n      mobileUl.innerHTML = mobileItems.map(item => `\n        <li class=\"nav-item list-item\" style=\"padding: 12px 16px; border-bottom: 1px solid rgba(0,0,0,0.05);\">\n          <a href=\"${item.url}\" class=\"nav-list-link\" style=\"font-weight: 700; color: ${item.accent ? '#C84B31' : '#1D3D40'}; font-size: 13px;\">\n            ${item.name}\n          </a>\n        </li>\n      `).join('');\n    }\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', injectGlitzHeaderLinks);\n  } else {\n    injectGlitzHeaderLinks();\n  }\n  setTimeout(injectGlitzHeaderLinks, 100);\n  setTimeout(injectGlitzHeaderLinks, 500);\n  setTimeout(injectGlitzHeaderLinks, 1200);\n})();\n</script>\n\n\n<script>\n(function() {\n  const allProducts = [{\"id\":\"250827081\",\"name\":\"Effervescent\",\"category\":\"Linha Niche\",\"categorySlug\":\"niche\",\"price\":177,\"originalPrice\":188,\"image\":\"https:/