e\":\"Solène\",\"category\":\"Perfumes Femininos\",\"categorySlug\":\"femininos\",\"price\":147,\"originalPrice\":188,\"image\":\"https://dcdn-us.mitiendanube.com/stores/008/277/830/products/solene_lab8-jpg-3-ec69448540fa970ed017863611205080-1024-1024-5611beeacf923bd9da17901738061300-1024-1024.webp\",\"badge\":\"OFERTA\",\"rating\":4.9,\"family\":\"Oriental Foug&egrave;re – Feminino\",\"handle\":\"solene-100-ml\",\"nuvemId\":369256941,\"variantId\":1601589870},{\"id\":\"364397710\",\"name\":\"Soul Me by Carina Albamonte\",\"category\":\"Perfumes Femininos\",\"categorySlug\":\"femininos\",\"price\":187,\"originalPrice\":220,\"image\":\"https://dcdn-us.mitiendanube.com/stores/008/277/830/products/soul-me-2-jpg-a8fbe0ef07f22a9c5617882059508777-1024-1024-eb8562228467b23d8e17901738070784-1024-1024.webp\",\"badge\":\"OFERTA\",\"rating\":4.7,\"family\":\"Amadeirado Aromático\",\"handle\":\"soul-me-100-ml\",\"nuvemId\":369256942,\"variantId\":1601589887}];\n\n  const categoryMeta = {\n    all: {\n      breadcrumb: 'Todos os Perfumes',\n      title: 'Todos os Perfumes',\n      desc: 'Explore nossa coleção completa de fragrâncias refinadas criadas com matérias-primas nobres e fixação duradoura.'\n    },\n    niche: {\n      breadcrumb: 'Linha Niche',\n      title: 'Linha Niche',\n      desc: 'Criações exclusivas da alta perfumaria com acordes raros, assinatura sensorial inconfundível e altíssima concentração.'\n    },\n    arabe: {\n      breadcrumb: 'Linha Árabe',\n      title: 'Linha Árabe',\n      desc: 'Fragrâncias opulentas com Oud nobre, especiarias quentes, âmbar e fixação extrema inspiradas no Oriente Médio.'\n    },\n    masculinos: {\n      breadcrumb: 'Perfumes Masculinos',\n      title: 'Perfumes Masculinos',\n      desc: 'Presença magnética, acordes amadeirados, aromáticos e couro com projeção marcante e elegância atemporal.'\n    },\n    femininos: {\n      breadcrumb: 'Perfumes Femininos',\n      title: 'Perfumes Femininos',\n      desc: 'Florais nobres, orientais envolventes e acordes adocicados com sofisticação e sensualidade irresistíveis.'\n    },\n    compartilhaveis: {\n      breadcrumb: 'Perfumes Compartilháveis',\n      title: 'Perfumes Compartilháveis',\n      desc: 'Fragrâncias contemporâneas e versáteis que redefinem o frescor cítrico, notas verdes e madeiras limpas para qualquer ocasião.'\n    },\n    ofertas: {\n      breadcrumb: 'Ofertas da Semana',\n      title: 'Ofertas Especiais',\n      desc: 'Condições exclusivas em suas assinaturas olfativas preferidas por tempo limitado.'\n    }\n  };\n\n  let currentSort = 'relevance';\n\n  function getActiveFilterFromUrl() {\n    const params = new URLSearchParams(window.location.search);\n    const cat = params.get('categoria');\n    if (cat) return cat.toLowerCase();\n    if (params.get('ofertas') === 'true') return 'ofertas';\n    return 'all';\n  }\n\n  function updateHeaderNavHighlight(filterKey) {\n    document.querySelectorAll('.glitz-header-link').forEach(link => {\n      const key = link.getAttribute('data-key');\n      const isAccent = key === 'ofertas';\n      const isHome = window.location.pathname === '/' || window.location.pathname === '';\n      const isActive = (key === 'home' && isHome) || (key === filterKey && !isHome) || (key === 'all' && filterKey === 'all' && !isHome);\n      \n      const color = isAccent ? '#C84B31' : (isActive ? '#C5A880' : '#1D3D40');\n      link.style.color = color;\n      link.style.borderBottom = isActive ? '2px solid #C5A880' : 'none';\n    });\n  }\n\n  function renderCatalog(filterKey) {\n    let filtered = allProducts;\n    if (filterKey === 'ofertas') {\n      filtered = allProducts.filter(p => p.originalPrice);\n    } else if (filterKey !== 'all') {\n      filtered = allProducts.filter(p => p.categorySlug === filterKey);\n    }\n\n    if (currentSort === 'price_asc') {\n      filtered = [...filtered].sort((a, b) => a.price - b.price);\n    } else if (currentSort === 'price_desc') {\n      filtered = [...filtered].sort((a, b) => b.price - a.price);\n    } else if (currentSort === 'best_selling') {\n      filtered = [...filtered].sort((a, b) => (b.rating || 5) - (a.rating || 5));\n    }\n\n    const meta = categoryMeta[filterKey] || categoryMeta.all;\n    const titleEl = document.getElementById('glitz-catalog-title');\n    const descEl = document.getElementById('glitz-catalog-desc');\n    const breadEl = document.getElementById('glitz-breadcrumb-current');\n    const countNumberEl = document.getElementById('glitz-catalog-count-number');\n\n    if (titleEl) titleEl.textContent = meta.title;\n    if (descEl) descEl.textContent = meta.desc;\n    if (breadEl) breadEl.textContent = meta.breadcrumb;\n    if (countNumberEl) countNumberEl.textContent = filtered.length;\n\n    updateHeaderNavHighlight(filterKey);\n\n    const gridEl = document.getElementById('glitz-catalog-grid');\n    if (!gridEl) return;\n\n    gridEl.innerHTML = filtered.map(p => {\n      const isOffer = !!p.originalPrice;\n      const badgeText = p.badge || (isOffer ? 'OFERTA' : '');\n      const badgeClass = isOffer ? 'glitz-badge-red' : '';\n      const priceFormatted = 'R$ ' + p.price.toFixed(2).replace('.', ',');\n      const oldPriceFormatted = isOffer ? 'R$ ' + p.originalPrice.toFixed(2).replace('.', ',') : '';\n      const installmentVal = (p.price / 6).toFixed(2).replace('.', ',');\n      const productUrl = '/produtos/' + p.handle;\n\n      return `\n        <div class=\"glitz-cat-card-item\">\n          <a href=\"${productUrl}\" class=\"glitz-cat-card-link\">\n            <div class=\"glitz-cat-card-media\">\n              ${badgeText ? '<span class=\"glitz-cat-card-badge ' + badgeClass + '\">' + badgeText + '</span>' : ''}\n              <img src=\"${p.image}\" alt=\"${p.name}\" class=\"glitz-cat-card-img\" loading=\"lazy\" />\n            </div>\n            <div class=\"glitz-cat-card-details\">\n              <div class=\"glitz-cat-card-meta\">\n                <span class=\"glitz-cat-card-category\">${p.category}</span>\n                <span class=\"glitz-cat-card-rating\">★ ${p.rating}</span>\n              </div>\n              <h3 class=\"glitz-cat-card-name\">${p.name}</h3>\n              <p class=\"glitz-cat-card-family\">${p.family}</p>\n              <div class=\"glitz-cat-card-price-row\">\n                <span class=\"glitz-cat-card-price\">${priceFormatted}</span>\n                ${oldPriceFormatted ? '<span class=\"glitz-cat-card-old-price\">' + oldPriceFormatted + '</span>' : ''}\n              </div>\n              <div class=\"glitz-cat-card-installments\">6x de R$ ${installmentVal} sem juros</div>\n            </div>\n          </a>\n          <div class=\"glitz-cat-card-actions\">\n            <button type=\"button\" class=\"glitz-cat-card-btn\" onclick=\"window.glitzAddToCart(${p.nuvemId}, '${p.handle}', this)\">\n              Adicionar à Sacola\n            </button>\n            <a href=\"${productUrl}\" class=\"glitz-cat-card-btn glitz-cat-card-btn-view\" title=\"Ver Detalhes\">\n              Ver\n            </a>\n          </div>\n        </div>\n      `;\n    }).join('');\n  }\n\n  document.addEventListener('DOMContentLoaded', () => {\n    renderCatalog(getActiveFilterFromUrl());\n\n    const sortSelect = document.getElementById('glitz-catalog-sort');\n    if (sortSelect) {\n      sortSelect.addEventListener('change', (e) => {\n        currentSort = e.target.value;\n        renderCatalog(getActiveFilterFromUrl());\n      });\n    }\n\n    document.addEventListener('click', (e) => {\n      const link = e.target.closest('.glitz-header-link');\n      if (link && window.location.pathname.includes('/produtos')) {\n        const key = link.getAttribute('data-key');\n        if (key === 'home') return; // let natural navigation to home happen\n        e.preventDefault();\n        const url = new URL(link.href, window.location.origin);\n        window.history.pushState({}, '', url.pathname + url.search);\n        renderCatalog(getActiveFilterFromUrl());\n      }\n    });\n\n    window.addEventListener('popstate', () => {\n      renderCatalog(getActiveFilterFromUrl());\n    });\n  });\n\n  setTimeout(() => {\n    renderCatalog(getActiveFilterFromUrl());\n  }, 100);\n})();\n</script>\n"
          }
        }
      },
      "block_order": [
        "catalog_block"
      ]
    }
  },
