 Guaiac\",\"&Acirc\",\"mbar\",\"Ládano\",\"Bálsamo\",\"Patchouli\",\"Civeta\",\"Vetiver\",\"Musgo de Carvalho\"]}},{\"id\":\"296207498\",\"name\":\"Eau de Dominique - FLUY\",\"category\":\"Compartilháveis\",\"categorySlug\":\"compartilhaveis\",\"price\":167,\"originalPrice\":188,\"image\":\"https://acdn-us.mitiendanube.com/stores/003/165/134/products/eau_de_dominique-37cf517822feb7f39817595272144320-1024-1024.webp\",\"badge\":\"OFERTA\",\"rating\":4.7,\"family\":\"Amadeirado Aromático\",\"notes\":{\"top\":[\"Flores Delicadas\"],\"heart\":[\"Frutas Suaves\"],\"base\":[\"Extratos Vegetais\"]}},{\"id\":\"298742002\",\"name\":\"Cherry Intense - FLUY\",\"category\":\"Perfumes Femininos\",\"categorySlug\":\"femininos\",\"price\":167,\"originalPrice\":188,\"image\":\"https://acdn-us.mitiendanube.com/stores/003/165/134/products/cherry_intense-0a4c07ff539dd434e517667855325231-1024-1024.webp\",\"badge\":\"OFERTA\",\"rating\":4.9,\"family\":\"Frutal Gourmand – Compartilhável\",\"notes\":{\"top\":[\"Cereja\",\"Limão\",\"Melancia\"],\"heart\":[\"Baunilha\",\"Jasmim\",\"Maçã\"],\"base\":[\"&Acirc\",\"mbar\",\"Caramelo\",\"Cedro\"]}},{\"id\":\"304414908\",\"name\":\"Audaz By Bil Araújo\",\"category\":\"Perfumes Masculinos\",\"categorySlug\":\"masculinos\",\"price\":187,\"originalPrice\":220,\"image\":\"https://acdn-us.mitiendanube.com/stores/003/165/134/products/img_7482_tratada-1-b6957140f2c9dbc73e17619373547734-1024-1024.webp\",\"badge\":\"OFERTA\",\"rating\":4.6,\"family\":\"Amadeirado Aromático\",\"notes\":{\"top\":[\"Bergamota Italiana\",\"Pomelo\",\"Pimenta Branca\"],\"heart\":[\"Couro\",\"Oud\",\"Cedro\"],\"base\":[\"&Acirc\",\"mbar\",\"Baunilha\",\"Musgo de Carvalho\"]}},{\"id\":\"359128366\",\"name\":\"Solène\",\"category\":\"Perfumes Femininos\",\"categorySlug\":\"femininos\",\"price\":147,\"originalPrice\":188,\"image\":\"https://acdn-us.mitiendanube.com/stores/003/165/134/products/solene_lab8-jpg-3-ec69448540fa970ed017863611205080-1024-1024.webp\",\"badge\":\"OFERTA\",\"rating\":4.9,\"family\":\"Oriental Foug&egrave;re – Feminino\",\"notes\":{\"top\":[\"🌸 Notas de Coração Flor de Laranjeira Tunisiana\",\"Jasmim Sambac\",\"Orquídea\"],\"heart\":[\"🔥 Notas de Fundo Baunilha\",\"Fava Tonka\",\"&Acirc\",\"mbar\",\"Vetiver\"],\"base\":[\"🤍 A Eleg&acirc\",\"ncia é a Forma Mais Marcante de Presença\"]}},{\"id\":\"364397710\",\"name\":\"Soul Me by Carina Albamonte\",\"category\":\"Perfumes Femininos\",\"categorySlug\":\"femininos\",\"price\":187,\"originalPrice\":220,\"image\":\"https://acdn-us.mitiendanube.com/stores/003/165/134/products/soul-me-2-jpg-a8fbe0ef07f22a9c5617882059508777-1024-1024.webp\",\"badge\":\"OFERTA\",\"rating\":4.7,\"family\":\"Amadeirado Aromático\",\"notes\":{\"top\":[\"Bergamota\",\"Cardamomo\",\"Pimenta Rosa\"],\"heart\":[\"✨ Notas de Fundo Vetiver\",\"Musk\",\"&Acirc\",\"mbar\",\"Caramelo\"],\"base\":[\"☀ Ocasiões de Uso: Versátil\",\"fácil  de  usar\",\"Soul  Me  acompanha  diferentes  momentos  do  dia.  Sua  saída  frutada\",\"luminosa  combina  com  a  rotina\",\"encontros  diurnos\",\"compromissos  especiais.  No  decorrer  das horas\",\"o  coração  floral  ganha  presença\",\"o  fundo  de  vetiver\",\"musk\",\"&acirc\",\"mbar\",\"caramelo  revela uma  faceta  mais  quente\",\"sofisticada\",\"envolvente  —  perfeita  para  jantares\",\"eventos\",\"encontros\",\"ocasiões em que você deseja deixar sua marca.\"]}}];\n\n  const categoryMeta = {\n    all: {\n      title: 'Todos os <strong>Perfumes</strong>',\n      desc: 'Explore nossa coleção completa de fragrâncias refinadas criadas com matérias-primas nobres e fixação duradoura.'\n    },\n    niche: {\n      title: 'Linha <strong>Niche</strong>',\n      desc: 'Criações exclusivas da alta perfumaria com acordes raros, assinatura sensorial inconfundível e altíssima concentração.'\n    },\n    arabe: {\n      title: 'Linha <strong>Árabe</strong>',\n      desc: 'Fragrâncias opulentas com Oud nobre, especiarias quentes, âmbar e fixação extrema inspiradas no Oriente Médio.'\n    },\n    masculinos: {\n      title: 'Perfumes <strong>Masculinos</strong>',\n      desc: 'Presença magnética, acordes amadeirados, aromáticos e couro com projeção marcante e elegância atemporal.'\n    },\n    femininos: {\n      title: 'Perfumes <strong>Femininos</strong>',\n      desc: 'Florais nobres, orientais envolventes e acordes adocicados com sofisticação e sensualidade irresistíveis.'\n    },\n    compartilhaveis: {\n      title: 'Perfumes <strong>Compartilháveis</strong>',\n      desc: 'Fragrâncias contemporâneas e versáteis que redefinem o frescor cítrico, notas verdes e madeiras limpas para qualquer ocasião.'\n    },\n    ofertas: {\n      title: 'Ofertas <strong>Especiais</strong>',\n      desc: 'Condições exclusivas em suas assinaturas olfativas preferidas por tempo limitado.'\n    }\n  };\n\n  function getActiveFilterFromUrl() {\n    const params = new URLSearchParams(window.location.search);\n    const cat = params.get('categoria');\n    if (cat) return cat.toLowerCase();\n    if (params.get('ofertas') === 'true') return 'ofertas';\n    return 'all';\n  }\n\n  function renderCatalog(filterKey) {\n    let filtered = allProducts;\n    if (filterKey === 'ofertas') {\n      filtered = allProducts.filter(p => p.originalPrice);\n    } else if (filterKey !== 'all') {\n      filtered = allProducts.filter(p => p.categorySlug === filterKey);\n    }\n\n    const meta = categoryMeta[filterKey] || categoryMeta.all;\n    const titleEl = document.getElementById('glitz-catalog-title');\n    const descEl = document.getElementById('glitz-catalog-desc');\n    const countEl = document.getElementById('glitz-catalog-count');\n\n    if (titleEl) titleEl.innerHTML = meta.title;\n    if (descEl) descEl.textContent = meta.desc;\n    if (countEl) countEl.innerHTML = 'Exibindo <strong>' + filtered.length + '</strong> fragrâncias exclusivas';\n\n    document.querySelectorAll('.glitz-filter-btn').forEach(btn => {\n      if (btn.getAttribute('data-filter') === filterKey) {\n        btn.classList.add('active');\n      } else {\n        btn.classList.remove('active');\n      }\n    });\n\n    const gridEl = document.getElementById('glitz-catalog-grid');\n    if (!gridEl) return;\n\n    gridEl.innerHTML = filtered.map(p => {\n      const isOffer = !!p.originalPrice;\n      const badgeText = p.badge || (isOffer ? 'OFERTA' : '');\n      const badgeClass = isOffer ? 'glitz-badge-red' : '';\n      const priceFormatted = 'R$ ' + p.price.toFixed(2).replace('.', ',');\n      const oldPriceFormatted = isOffer ? 'R$ ' + p.originalPrice.toFixed(2).replace('.', ',') : '';\n      const installmentVal = (p.price / 6).toFixed(2).replace('.', ',');\n\n      return `\n        <div class=\"glitz-cat-card-item\">\n          <div class=\"glitz-cat-card-media\">\n            ${badgeText ? '<span class=\"glitz-cat-card-badge ' + badgeClass + '\">' + badgeText + '</span>' : ''}\n            <img src=\"${p.image}\" alt=\"${p.name}\" class=\"glitz-cat-card-img\" loading=\"lazy\" />\n          </div>\n          <div class=\"glitz-cat-card-details\">\n            <div class=\"glitz-cat-card-meta\">\n              <span class=\"glitz-cat-card-category\">${p.category}</span>\n              <span class=\"glitz-cat-card-rating\">★ ${p.rating}</span>\n            </div>\n            <h3 class=\"glitz-cat-card-name\">${p.name}</h3>\n            <p class=\"glitz-cat-card-family\">${p.family}</p>\n            <div class=\"glitz-cat-card-price-row\">\n              <span class=\"glitz-cat-card-price\">${priceFormatted}</span>\n              ${oldPriceFormatted ? '<span class=\"glitz-cat-card-old-price\">' + oldPriceFormatted + '</span>' : ''}\n            </div>\n            <div class=\"glitz-cat-card-installments\">6x de R$ ${installmentVal} sem juros</div>\n            <button type=\"button\" class=\"glitz-cat-card-btn\" onclick=\"alert('Fragrância ${p.name} adicionada à sacola!')\">\n              Adicionar à Sacola\n            </button>\n          </div>\n        </div>\n      `;\n    }).join('');\n  }\n\n  document.addEventListener('DOMContentLoaded', () => {\n    const initialFilter = getActiveFilterFromUrl();\n    renderCatalog(initialFilter);\n\n    document.querySelectorAll('.glitz-filter-btn').forEach(btn => {\n      btn.addEventListener('click', (e) => {\n        const filter = btn.getAttribute('data-filter');\n        let newUrl = '/produtos';\n        if (filter === 'ofertas') newUrl += '?ofertas=true';\n        else if (filter !== 'all') newUrl += '?categoria=' + filter;\n        window.history.pushState({ filter }, '', newUrl);\n        renderCatalog(filter);\n      });\n    });\n\n    window.addEventListener('popstate', () => {\n      renderCatalog(getActiveFilterFromUrl());\n    });\n  });\n\n  setTimeout(() => {\n    renderCatalog(getActiveFilterFromUrl());\n  }, 100);\n})();\n</script>\n",
            "width": "fill"
          }
        }
      },
      "block_order": [
        "catalog_block"
      ]
    }
  },
