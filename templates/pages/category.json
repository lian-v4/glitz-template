          "settings": {
            "code": "\n<style>\n\n/* --- GLITZ MANDATORY SECTION CONTAINER & LATERAL PADDING --- */\n.glitz-container {\n  width: 100% !important;\n  max-width: 1340px !important;\n  margin-left: auto !important;\n  margin-right: auto !important;\n  padding-left: 48px !important;\n  padding-right: 48px !important;\n  box-sizing: border-box !important;\n}\n\n@media (max-width: 1024px) {\n  .glitz-container {\n    padding-left: 32px !important;\n    padding-right: 32px !important;\n  }\n}\n\n@media (max-width: 768px) {\n  .glitz-container {\n    padding-left: 20px !important;\n    padding-right: 20px !important;\n  }\n}\n\n.glitz-hero-inner,\n.glitz-hero-container {\n  width: 100% !important;\n  max-width: 1340px !important;\n  margin-left: auto !important;\n  margin-right: auto !important;\n  padding-left: 48px !important;\n  padding-right: 48px !important;\n  box-sizing: border-box !important;\n}\n\n@media (max-width: 1024px) {\n  .glitz-hero-inner,\n  .glitz-hero-container {\n    padding-left: 32px !important;\n    padding-right: 32px !important;\n  }\n}\n\n@media (max-width: 768px) {\n  .glitz-hero-inner,\n  .glitz-hero-container {\n    padding-left: 20px !important;\n    padding-right: 20px !important;\n  }\n}\n\n.glitz-catalog-body,\n.glitz-catalog-header-inner,\n.glitz-catalog-container {\n  width: 100% !important;\n  max-width: 1340px !important;\n  margin-left: auto !important;\n  margin-right: auto !important;\n  padding-left: 48px !important;\n  padding-right: 48px !important;\n  box-sizing: border-box !important;\n}\n\n@media (max-width: 1024px) {\n  .glitz-catalog-body,\n  .glitz-catalog-header-inner,\n  .glitz-catalog-container {\n    padding-left: 32px !important;\n    padding-right: 32px !important;\n  }\n}\n\n@media (max-width: 768px) {\n  .glitz-catalog-body,\n  .glitz-catalog-header-inner,\n  .glitz-catalog-container {\n    padding-left: 20px !important;\n    padding-right: 20px !important;\n  }\n}\n\n\n.section-main-products-grid,\n.section-category-hero,\n.section-page-header {\n  display: none !important;\n}\n\n.glitz-catalog-wrapper {\n  background: #F8F7F3;\n  min-height: 100vh;\n  width: 100%;\n}\n\n.glitz-catalog-header {\n  background: #1D3D40;\n  padding: 56px 24px;\n  color: #FFFFFF;\n  position: relative;\n  overflow: hidden;\n}\n\n.glitz-catalog-header-inner {\n  max-width: 1400px;\n  margin: 0 auto;\n}\n\n.glitz-catalog-breadcrumb {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 12px;\n  color: rgba(255, 255, 255, 0.55);\n  margin-bottom: 18px;\n}\n\n.glitz-catalog-breadcrumb a {\n  color: rgba(255, 255, 255, 0.6);\n  text-decoration: none;\n  transition: color 0.2s;\n}\n\n.glitz-catalog-breadcrumb a:hover {\n  color: #DFCEB8;\n}\n\n.glitz-catalog-title {\n  font-family: 'Cinzel', serif;\n  font-size: clamp(2.2rem, 4vw, 3.6rem);\n  font-weight: 400;\n  color: #FFFFFF;\n  margin: 0 0 10px 0;\n  letter-spacing: 0.04em;\n  line-height: 1.15;\n}\n\n.glitz-catalog-desc {\n  font-family: 'Plus Jakarta Sans', sans-serif;\n  font-size: 14px;\n  color: rgba(255, 255, 255, 0.7);\n  max-width: 680px;\n  margin: 0;\n  line-height: 1.6;\n  font-weight: 300;\n}\n\n.glitz-catalog-container {\n  max-width: 1400px;\n  margin: 0 auto;\n  padding: 40px 24px 80px 24px;\n}\n\n.glitz-catalog-controls {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 32px;\n  padding-bottom: 18px;\n  border-bottom: 1px solid #E2E8E7;\n}\n\n.glitz-catalog-count-text {\n  font-size: 14px;\n  color: #707978;\n}\n\n.glitz-catalog-count-text strong {\n  color: #182324;\n  font-weight: 700;\n}\n\n.glitz-sort-wrapper {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.glitz-sort-label {\n  font-size: 12px;\n  color: #707978;\n  font-weight: 600;\n}\n\n.glitz-sort-select {\n  font-family: 'Plus Jakarta Sans', sans-serif;\n  font-size: 12px;\n  font-weight: 600;\n  color: #182324;\n  background: #FFFFFF;\n  border: 1px solid #E2E8E7;\n  padding: 8px 16px;\n  border-radius: 6px;\n  outline: none;\n  cursor: pointer;\n}\n\n.glitz-catalog-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 24px;\n}\n\n@media (max-width: 1100px) {\n  .glitz-catalog-grid { grid-template-columns: repeat(3, 1fr); gap: 18px; }\n}\n\n@media (max-width: 768px) {\n  .glitz-catalog-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }\n  .glitz-catalog-header { padding: 36px 16px; }\n  .glitz-catalog-container { padding: 24px 16px 60px 16px; }\n  .glitz-catalog-controls { flex-direction: column; align-items: flex-start; gap: 12px; }\n}\n\n.glitz-cat-card-item {\n  background: #FFFFFF;\n  border-radius: 12px;\n  border: 1px solid #E5EAE9;\n  overflow: hidden;\n  transition: all 0.3s ease;\n  display: flex;\n  flex-direction: column;\n}\n\n.glitz-cat-card-item:hover {\n  transform: translateY(-4px);\n  border-color: #DFCEB8;\n  box-shadow: 0 12px 24px rgba(0,0,0,0.06);\n}\n\n.glitz-cat-card-link {\n  text-decoration: none !important;\n  color: inherit !important;\n  display: flex;\n  flex-direction: column;\n  flex-grow: 1;\n}\n\n.glitz-cat-card-media {\n  position: relative;\n  aspect-ratio: 1 / 1;\n  background: #F8F9FA;\n  overflow: hidden;\n}\n\n.glitz-cat-card-img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: transform 0.5s ease;\n}\n\n.glitz-cat-card-item:hover .glitz-cat-card-img {\n  transform: scale(1.05);\n}\n\n.glitz-cat-card-badge {\n  position: absolute;\n  top: 10px;\n  left: 10px;\n  background: #1D3D40;\n  color: #FFFFFF;\n  font-size: 9px;\n  font-weight: 800;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  padding: 4px 8px;\n  border-radius: 4px;\n  z-index: 10;\n}\n\n.glitz-badge-red { background: #C84B31 !important; }\n\n.glitz-cat-card-details {\n  padding: 16px;\n  display: flex;\n  flex-direction: column;\n  flex-grow: 1;\n}\n\n.glitz-cat-card-meta {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 6px;\n}\n\n.glitz-cat-card-category {\n  font-size: 10px;\n  color: #707978;\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n  font-weight: 700;\n}\n\n.glitz-cat-card-rating {\n  font-size: 11px;\n  color: #C5A880;\n  font-weight: 700;\n}\n\n.glitz-cat-card-name {\n  font-size: 15px;\n  font-weight: 600;\n  line-height: 1.35;\n  margin: 0 0 4px 0;\n  color: #182324;\n}\n\n.glitz-cat-card-family {\n  font-size: 11px;\n  color: #707978;\n  margin: 0 0 12px 0;\n  font-weight: 400;\n}\n\n.glitz-cat-card-price-row {\n  display: flex;\n  align-items: baseline;\n  gap: 8px;\n  margin-top: auto;\n}\n\n.glitz-cat-card-price {\n  font-size: 1.15rem;\n  font-weight: 800;\n  color: #1D3D40;\n}\n\n.glitz-cat-card-old-price {\n  font-size: 0.85rem;\n  color: #A0A5A5;\n  text-decoration: line-through;\n}\n\n.glitz-cat-card-installments {\n  font-size: 11px;\n  color: #707978;\n  margin-top: 4px;\n}\n\n.glitz-cat-card-actions {\n  padding: 0 16px 16px 16px;\n  display: flex;\n  gap: 8px;\n}\n\n.glitz-cat-card-btn {\n  flex: 1;\n  background: #C5A880;\n  color: #FFFFFF !important;\n  text-decoration: none !important;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  padding: 10px 14px;\n  border-radius: 9999px;\n  text-align: center;\n  transition: all 0.2s ease;\n  border: none;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.glitz-cat-card-btn:hover {\n  background: #9D7F57;\n}\n\n.glitz-cat-card-btn-view {\n  background: #F8F7F3;\n  color: #1D3D40 !important;\n  border: 1px solid #E2E8E7;\n}\n\n.glitz-cat-card-btn-view:hover {\n  background: #EAE6DF;\n}\n</style>\n\n<div class=\"glitz-catalog-wrapper\">\n  <div class=\"glitz-catalog-header\">\n    <div class=\"glitz-catalog-header-inner\">\n      <div class=\"glitz-catalog-breadcrumb\">\n        <a href=\"/\">Home</a>\n        <span>/</span>\n        <span id=\"glitz-breadcrumb-current\">Perfumes</span>\n      </div>\n      <h1 class=\"glitz-catalog-title\" id=\"glitz-catalog-title\">Todos os Perfumes</h1>\n      <p class=\"glitz-catalog-desc\" id=\"glitz-catalog-desc\">\n        Explore nossa curadoria de fragrâncias de alta concentração, matérias-primas nobres e fixação duradoura.\n      </p>\n    </div>\n  </div>\n\n  <div class=\"glitz-catalog-container\">\n    <div class=\"glitz-catalog-controls\">\n      <div class=\"glitz-catalog-count-text\">\n        <strong id=\"glitz-catalog-count-number\">48</strong> produtos encontrados\n      </div>\n      <div class=\"glitz-sort-wrapper\">\n        <span class=\"glitz-sort-label\">Ordenar:</span>\n        <select class=\"glitz-sort-select\" id=\"glitz-catalog-sort\">\n          <option value=\"relevance\">Mais relevantes</option>\n          <option value=\"best_selling\">Mais vendidos</option>\n          <option value=\"price_asc\">Menor preço</option>\n          <option value=\"price_desc\">Maior preço</option>\n        </select>\n      </div>\n    </div>\n\n    <div class=\"glitz-catalog-grid\" id=\"glitz-catalog-grid\"></div>\n  </div>\n</div>\n\n\n<script>\n(function() {\n  function injectGlitzHeaderLinks() {\n    const navUl = document.querySelector('.js-nav-desktop-list');\n    if (navUl) {\n      const navItems = [\n        { name: 'INÍCIO', url: '/', key: 'home' },\n        { name: 'TODOS OS PERFUMES', url: '/produtos', key: 'all' },\n        { name: 'LINHA NICHE', url: '/produtos?categoria=niche', key: 'niche' },\n        { name: 'LINHA ÁRABE', url: '/produtos?categoria=arabe', key: 'arabe' },\n        { name: 'MASCULINOS', url: '/produtos?categoria=masculinos', key: 'masculinos' },\n        { name: 'FEMININOS', url: '/produtos?categoria=femininos', key: 'femininos' },\n        { name: 'COMPARTILHÁVEIS', url: '/produtos?categoria=compartilhaveis', key: 'compartilhaveis' },\n        { name: 'OFERTAS', url: '/produtos?ofertas=true', key: 'ofertas', accent: true }\n      ];\n\n      const currentParams = new URLSearchParams(window.location.search);\n      const activeCat = currentParams.get('categoria') || (currentParams.get('ofertas') === 'true' ? 'ofertas' : '');\n\n      navUl.innerHTML = navItems.map(item => {\n        const isHome = window.location.pathname === '/' || window.location.pathname === '';\n        const isActive = (item.key === 'home' && isHome) || (item.key === activeCat && !isHome) || (item.key === 'all' && !activeCat && !isHome && window.location.pathname.includes('/produtos'));\n        const color = item.accent ? '#C84B31' : (isActive ? '#C5A880' : '#1D3D40');\n        const borderBottom = isActive ? 'border-bottom: 2px solid #C5A880;' : '';\n\n        return `\n          <li class=\"nav-item nav-main-item\" style=\"margin: 0 12px;\">\n            <a href=\"${item.url}\" class=\"nav-list-link glitz-header-link\" data-key=\"${item.key}\" style=\"\n              font-family: 'Plus Jakarta Sans', sans-serif !important;\n              font-size: 11px !important;\n              font-weight: 700 !important;\n              letter-spacing: 0.14em !important;\n              text-transform: uppercase !important;\n              color: ${color} !important;\n              text-decoration: none !important;\n              padding-bottom: 4px;\n              ${borderBottom}\n              transition: all 0.2s ease;\n            \" onmouseover=\"this.style.color='#C5A880'\" onmouseout=\"this.style.color='${color}'\">\n              ${item.name}\n            </a>\n          </li>\n        `;\n      }).join('');\n\n      const navContainer = document.querySelector('.js-nav-desktop-container');\n      if (navContainer) {\n        navContainer.style.visibility = 'visible';\n        navContainer.style.height = 'auto';\n        navContainer.style.display = 'block';\n      }\n    }\n\n    const mobileUl = document.querySelector('.nav-categories-mobile') || document.querySelector('.js-mobile-nav-list');\n    if (mobileUl && !mobileUl.getAttribute('data-glitz-nav-done')) {\n      mobileUl.setAttribute('data-glitz-nav-done', 'true');\n      const mobileItems = [\n        { name: 'Início', url: '/' },\n        { name: 'Todos os Perfumes', url: '/produtos' },\n        { name: 'Linha Niche', url: '/produtos?categoria=niche' },\n        { name: 'Linha Árabe', url: '/produtos?categoria=arabe' },\n        { name: 'Perfumes Masculinos', url: '/produtos?categoria=masculinos' },\n        { name: 'Perfumes Femininos', url: '/produtos?categoria=femininos' },\n        { name: 'Compartilháveis', url: '/produtos?categoria=compartilhaveis' },\n        { name: 'Ofertas da Semana', url: '/produtos?ofertas=true', accent: true }\n      ];\n      mobileUl.innerHTML = mobileItems.map(item => `\n        <li class=\"nav-item list-item\" style=\"padding: 12px 16px; border-bottom: 1px solid rgba(0,0,0,0.05);\">\n          <a href=\"${item.url}\" class=\"nav-list-link\" style=\"font-weight: 700; color: ${item.accent ? '#C84B31' : '#1D3D40'}; font-size: 13px;\">\n            ${item.name}\n          </a>\n        </li>\n      `).join('');\n    }\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', injectGlitzHeaderLinks);\n  } else {\n    injectGlitzHeaderLinks();\n  }\n  setTimeout(injectGlitzHeaderLinks, 100);\n  setTimeout(injectGlitzHeaderLinks, 500);\n  setTimeout(injectGlitzHeaderLinks, 1200);\n})();\n</script>\n\n\n<script>\nwindow.glitzAddToCart = function(nuvemId, handle, btnEl) {\n  if (!nuvemId) {\n    window.location.href = '/produtos/' + handle;\n    return;\n  }\n  if (btnEl) {\n    btnEl.innerHTML = '<span>Adicionando...</span>';\n    btnEl.style.opacity = '0.7';\n  }\n\n  const form = document.createElement('form');\n  form.method = 'POST';\n  form.action = '/comprar';\n\n  const input = document.createElement('input');\n  input.type = 'hidden';\n  input.name = 'add_to_cart';\n  input.value = nuvemId;\n  form.appendChild(input);\n\n  document.body.appendChild(form);\n  form.submit();\n};\n</script>\n\n\n<script>\n(function() {\n  const allProdu