{
  "sections": {
    "hero_glitz": {
      "type": "hero",
      "settings": {
        "alignment": "left",
        "height": "large",
        "auto_height": false,
        "gap": 20,
        "vertical_padding": 60,
        "horizontal_padding": 40,
        "text_color": "#FFFFFF",
        "show_overlay": true,
        "overlay_color": "#0D1C1E",
        "overlay_opacity": 65
      },
      "blocks": {
        "pill": {
          "type": "label",
          "settings": {
            "text": "ALTA PERFUMARIA & FRAGRÂNCIAS DE NICHO",
            "style": "filled"
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "title": "Sua Essência, Seu Mais Nobre Momento.",
            "size": "custom",
            "custom_font_size": 58,
            "custom_mobile_font_size": 36,
            "mobile_font_size": true
          }
        },
        "description": {
          "type": "text",
          "settings": {
            "text": "Fragrâncias refinadas e fórmulas de alta concentração criadas para expressar sua autenticidade com projeção elegante e fixação duradoura.",
            "size": "paragraph_big"
          }
        },
        "cta_button": {
          "type": "button",
          "settings": {
            "label": "Explorar Todos os Perfumes",
            "variant": "primary",
            "size": "big",
            "url": "/produtos"
          }
        }
      },
      "block_order": [
        "pill",
        "heading",
        "description",
        "cta_button"
      ]
    },
    "featured_categories": {
      "type": "featured-categories",
      "settings": {
        "orientation": "horizontal",
        "text_alignment": "center",
        "section_width": "page",
        "gap": 16,
        "vertical_padding": 50,
        "horizontal_padding": 20,
        "background_color": "#F8F7F3"
      }
    },
    "best_sellers": {
      "type": "product-list",
      "settings": {
        "alignment": "left",
        "section_width": "page",
        "gap": 20,
        "vertical_padding": 50
      },
      "blocks": {
        "header_group": {
          "type": "group",
          "settings": {
            "direction": "row",
            "alignment": "space_between",
            "alignment_vertical": "center"
          },
          "blocks": {
            "heading": {
              "type": "heading",
              "settings": {
                "title": "Mais Desejados",
                "size": "h2"
              }
            },
            "view_all": {
              "type": "view-all-button",
              "settings": {
                "label": "Ver Todos os Perfumes",
                "variant": "secondary",
                "url": "/produtos"
              }
            }
          },
          "block_order": [
            "heading",
            "view_all"
          ]
        },
        "products_grid": {
          "type": "products",
          "settings": {
            "format": "grid",
            "columns": "4",
            "columns_mobile": "2"
          }
        }
      },
      "block_order": [
        "header_group",
        "products_grid"
      ]
    },
    "promotional_spotlight": {
      "type": "image-with-text",
      "settings": {
        "section_width": "page",
        "gap": 24,
        "vertical_padding": 50,
        "horizontal_padding": 20,
        "background_color": "#1D3D40",
        "text_color": "#FFFFFF"
      },
      "blocks": {
        "module": {
          "type": "image-with-text",
          "settings": {
            "title": "Oud Premium · Linha Árabe",
            "text": "Uma jornada sensorial incomparável com notas nobres de Oud, especiarias quentes e base ambarada. Projeção marcante que permanece.",
            "button_label": "Conhecer a Linha Árabe",
            "button_variant": "primary",
            "button_url": "/categoria/arabe"
          }
        }
      },
      "block_order": [
        "module"
      ]
    },
    "weekly_offers": {
      "type": "product-list",
      "settings": {
        "alignment": "left",
        "section_width": "page",
        "gap": 20,
        "vertical_padding": 50
      },
      "blocks": {
        "header_group_offers": {
          "type": "group",
          "settings": {
            "direction": "row",
            "alignment": "space_between",
            "alignment_vertical": "center"
          },
          "blocks": {
            "heading_offers": {
              "type": "heading",
              "settings": {
                "title": "Ofertas da Semana",
                "size": "h2"
              }
            },
            "view_all_offers": {
              "type": "view-all-button",
              "settings": {
                "label": "Ver Todas as Ofertas",
                "variant": "secondary",
                "url": "/ofertas"
              }
            }
          },
          "block_order": [
            "heading_offers",
            "view_all_offers"
          ]
        },
        "products_grid_offers": {
          "type": "products",
          "settings": {
            "format": "grid",
            "columns": "4",
            "columns_mobile": "2"
          }
        }
      },
      "block_order": [
        "header_group_offers",
        "products_grid_offers"
      ]
    },
    "brand_benefits": {
      "type": "icon-text",
      "settings": {
        "alignment": "center",
        "section_width": "page",
        "gap": 24,
        "vertical_padding": 50,
        "horizontal_padding": 20,
        "background_color": "#F8F7F3",
        "text_color": "#182324",
        "icon_color": "#C5A880"
      },
      "blocks": {
        "benefit_group": {
          "type": "icon-text-group",
          "settings": {
            "alignment": "center",
            "gap": 24
          },
          "blocks": {
            "b1": {
              "type": "icon-text-item",
              "settings": {
                "icon": "shipping",
                "title": "Entrega Rápida & Segura",
                "description": "Despacho ágil com rastreio para todo o Brasil."
              }
            },
            "b2": {
              "type": "icon-text-item",
              "settings": {
                "icon": "security",
                "title": "Produtos 100% Originais",
                "description": "Garantia de autenticidade e matérias-primas nobres."
              }
            },
            "b3": {
              "type": "icon-text-item",
              "settings": {
                "icon": "returns",
                "title": "Curadoria de Excelência",
                "description": "Apenas fragrâncias selecionadas com altíssima fixação."
              }
            },
            "b4": {
              "type": "icon-text-item",
              "settings": {
                "icon": "support",
                "title": "Atendimento Especializado",
                "description": "Consultores prontos para ajudar na sua escolha."
              }
            }
          },
          "block_order": [
            "b1",
            "b2",
            "b3",
            "b4"
          ]
        }
      },
      "block_order": [
        "benefit_group"
      ]
    },
    "newsletter_section": {
      "type": "newsletter",
      "settings": {
        "section_width": "page",
        "vertical_padding": 50,
        "horizontal_padding": 20,
        "background_color": "#1D3D40",
        "text_color": "#FFFFFF"
      },
      "blocks": {
        "form": {
          "type": "newsletter-form",
          "settings": {
            "title": "Descubra Sua Próxima Assinatura Olfativa",
            "description": "Receba lançamentos exclusivos, guias olfativos e ofertas em primeira mão."
          }
        }
      },
      "block_order": [
        "form"
      ]
    }
  },
  "order": [
    "hero_glitz",
    "featured_categories",
    "best_sellers",
    "promotional_spotlight",
    "weekly_offers",
    "brand_benefits",
    "newsletter_section"
  ]
}